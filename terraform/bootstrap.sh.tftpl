#!/usr/bin/env bash
set -euo pipefail

exec > >(tee -a /var/log/travel-expenses-bootstrap.log) 2>&1

apt-get update
apt-get install -y ca-certificates curl gnupg

# Install Docker Engine and the Compose plugin from Docker's official APT repo.
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

docker_arch="$(dpkg --print-architecture)"
ubuntu_codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
printf 'Types: deb\nURIs: https://download.docker.com/linux/ubuntu\nSuites: %s\nComponents: stable\nArchitectures: %s\nSigned-By: /etc/apt/keyrings/docker.asc\n' \
  "$ubuntu_codename" "$docker_arch" > /etc/apt/sources.list.d/docker.sources

# Install Caddy from its official stable APT repo.
curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/gpg.key \
  | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
curl -1sLf https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt \
  -o /etc/apt/sources.list.d/caddy-stable.list
chmod o+r /usr/share/keyrings/caddy-stable-archive-keyring.gpg
chmod o+r /etc/apt/sources.list.d/caddy-stable.list

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y \
  docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin caddy

# The attachment can finish shortly after cloud-init starts. Match the EBS
# volume by its NVMe serial instead of assuming a device name on Nitro EC2.
expected_volume_id="${data_volume_id}"
data_device=""
for attempt in $(seq 1 60); do
  for candidate in /dev/nvme*n1; do
    [ -b "$candidate" ] || continue
    serial="$(lsblk -ndo SERIAL "$candidate" | tr -d '-')"
    if [ "$serial" = "$expected_volume_id" ]; then
      data_device="$candidate"
      break 2
    fi
  done
  sleep 5
done

if [ -z "$data_device" ]; then
  echo "Attached EBS data volume $expected_volume_id was not found; refusing to continue." >&2
  exit 1
fi

filesystem="$(blkid -o value -s TYPE "$data_device" || true)"
if [ -z "$filesystem" ]; then
  mkfs.ext4 -F "$data_device"
elif [ "$filesystem" != "ext4" ]; then
  echo "Expected an ext4 data volume, found $filesystem; refusing to format it." >&2
  exit 1
fi

install -d -m 0750 /srv/viaje-claro-data
volume_uuid="$(blkid -o value -s UUID "$data_device")"
if ! grep -q "UUID=$volume_uuid " /etc/fstab; then
  printf 'UUID=%s /srv/viaje-claro-data ext4 defaults,nofail 0 2\n' "$volume_uuid" >> /etc/fstab
fi
mount /srv/viaje-claro-data
systemctl enable --now docker

# Serve HTTP on the instance IP for initial smoke checks. Replace :80 with the
# chosen DNS name later so Caddy can provision HTTPS certificates automatically.
cat > /etc/caddy/Caddyfile <<'CADDYFILE'
:80 {
    reverse_proxy 127.0.0.1:5173
}
CADDYFILE

systemctl enable caddy
systemctl restart caddy
